--- /dev/null
+++ b/App/Services/DuelXuXiaoPresentationTrace.swift
@@ -0,0 +1,29 @@
+#if L12_INTERNAL_PREVIEW && L12_PRESENTATION_DIAGNOSTICS
+import Foundation
+
+/// Test-only, double-gated, bounded lifecycle markers. No dynamic/user values.
+@MainActor
+enum DuelXuXiaoPresentationTrace {
+    enum Stage: String {
+        case entryTapped = "xu-entry-tapped"
+        case coverConstructed = "xu-cover-constructed"
+        case previewAppeared = "xu-preview-appeared"
+        case previewDisappeared = "xu-preview-disappeared"
+    }
+    private static var recorded: [Stage] = []
+    static func record(_ stage: Stage) {
+        guard ProcessInfo.processInfo.arguments.contains("-xu-presentation-trace"),
+              !recorded.contains(stage), recorded.count < 4 else { return }
+        recorded.append(stage)
+        let bytes = Data((recorded.map(\.rawValue).joined(separator: "\n") + "\n").utf8)
+        guard bytes.count <= 256,
+              let caches = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask).first else { return }
+        do {
+            try FileManager.default.createDirectory(at: caches, withIntermediateDirectories: true)
+            try bytes.write(to: caches.appendingPathComponent("rift-xu-presentation-stages.log"), options: .atomic)
+        } catch {
+            // Observation failure never changes gameplay or presentation.
+        }
+    }
+}
+#endif
