diff --git a/App/Services/DuelSerpentHeadlessMorphScene.swift b/App/Services/DuelSerpentHeadlessMorphScene.swift
new file mode 100644
--- /dev/null
+++ b/App/Services/DuelSerpentHeadlessMorphScene.swift
@@ -0,0 +1,72 @@
+import SceneKit
+
+/// The exact D13 export preserves a personal head and neck outside its active
+/// scene because the original closed helmet declares Headless=1. No other
+/// missing material is optional. This selects a view; it never reparents nodes,
+/// changes bind matrices, hides geometry, or removes the preserved identity.
+@MainActor
+enum DuelSerpentHeadlessMorphScene {
+    struct Selection {
+        let instance: GLTFModel.Instance
+        let materials: [DuelTriadSourceMorph.MaterialBinding]
+    }
+    static let activeNames: Set<String> = ["mat_arm__agl_41_base", "mat_arm__agl_41_tie_base",
+        "mat_helm__agl_41_base", "mat_wpn__shuangou_01_04_base"]
+    static let dormantNames: Set<String> = ["Liu_Neck_Skin", "tripo_mat_c4757646"]
+
+    static func select(asset: DuelWeaponCharacterAsset, instance: GLTFModel.Instance,
+                       materials: [DuelTriadSourceMorph.MaterialBinding]) throws -> Selection {
+        guard asset.profile.isSerpent else { return Selection(instance: instance, materials: materials) }
+        func require(_ condition: Bool) throws {
+            guard condition else { throw DuelTriadSourceMorph.Failure.geometry }
+        }
+        let allNames = activeNames.union(dormantNames)
+        try require(asset.profile.id == "liu_serpent" && asset.profile.bytes == 15_561_412 &&
+            asset.profile.sha256 == "f25b35dec9bf335bbe01ceee557389f47165c3d0b45b54502017fda394a8bd70" &&
+            asset.profile.resourceName == "Liu_KingOfSerpents_D13_Recovered_Combat" &&
+            asset.model.names.count == 90 && instance.nodes.count == 90 && instance.outlines.isEmpty)
+        try require(materials.count == 6 && Set(materials.map(\.name)) == allNames &&
+            instance.materials.count == 6 && Set(instance.materials.compactMap(\.name)) == allNames &&
+            Set(instance.materials.map(ObjectIdentifier.init)).count == 6)
+        for material in materials { try material.validate() }
+        let names = ["arm__agl_41_m", "arm__agl_41_m_tabard", "arm__agl_41_m_tie_down",
+            "arm__agl_41_m_tie_up", "helm__agl_41_m", "wpn__shuangou_01_04__l", "wpn__shuangou_01_04__r",
+            "Liu_Neck_Bridge", "Liu_Personal_Head", "SF3_Actor_Meters"]
+        try require(Array(asset.model.names[80...89]) == names)
+        let outer = instance.nodes[89]
+        try require(outer.parent === instance.root && instance.root.childNodes.count == 1)
+        var activeHolders: [SCNNode] = []
+        for index in 80...86 {
+            let node = instance.nodes[index]
+            try require(node.parent === outer && node.childNodes.count == 1)
+            let holder = node.childNodes[0]
+            try require(holder.geometry != nil && holder.skinner != nil)
+            activeHolders.append(holder)
+        }
+        for (index, name) in [(87, "Liu_Neck_Skin"), (88, "tripo_mat_c4757646")] {
+            let node = instance.nodes[index]
+            try require(node.parent == nil && node.childNodes.count == 1)
+            let holder = node.childNodes[0]
+            try require(holder.skinner != nil && holder.geometry?.materials.count == 1 &&
+                holder.geometry?.materials.first?.name == name)
+            let definition = materials.first { $0.name == name }
+            try require(definition?.actorBaseGeometry == true && definition?.sourceItemType == nil)
+        }
+        var actualHolders: [SCNNode] = []
+        instance.root.enumerateChildNodes { node, _ in
+            if node.geometry != nil { actualHolders.append(node) }
+        }
+        try require(instance.root.geometry == nil && actualHolders.count == 7 &&
+            Set(actualHolders.map(ObjectIdentifier.init)) == Set(activeHolders.map(ObjectIdentifier.init)))
+        let active = activeHolders.flatMap { $0.geometry?.materials ?? [] }
+        try require(active.count == 7 && Set(active.compactMap(\.name)) == activeNames)
+        let activeIDs = Set(active.map(ObjectIdentifier.init))
+        let selected = instance.materials.filter { activeIDs.contains(ObjectIdentifier($0)) }
+        try require(selected.count == 4 && Set(selected.compactMap(\.name)) == activeNames)
+        // Generic MORPH keeps its complete material/geometry equality check.
+        // Only this authenticated actor can supply the reduced active scene.
+        return Selection(instance: .init(root: instance.root, nodes: instance.nodes,
+                materials: selected, outlines: instance.outlines),
+            materials: materials.filter { activeNames.contains($0.name) })
+    }
+}
