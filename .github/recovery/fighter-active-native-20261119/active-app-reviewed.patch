+++ b/scripts/test_completion_active_pack.py
@@ -0,0 +1,45 @@
+import hashlib
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import completion_active_pack as active
+import completion_native_preflight as original
+
+
+class ActivePackTests(unittest.TestCase):
+    def test_only_retired_model_and_test_oracle_excluded(self):
+        root = Path(__file__).resolve().parents[1]
+        history = original.metadata(root)[1]["compiledFiles"]
+        rows, digest = active.active_inventory(root)
+        self.assertEqual({r["name"]: r for r in history if r not in rows}, active.EXCLUDED)
+        self.assertEqual(len(rows), 539)
+        self.assertNotEqual(digest, original.COMPILED_CONTENT_SHA256)
+        self.assertTrue(active.REQUIRED <= {r["name"] for r in rows})
+
+    def test_stage_and_bundle_allow_valid_resource_without_hammers(self):
+        with tempfile.TemporaryDirectory() as d:
+            base = Path(d)
+            data = b"synthetic"
+            name = "SF3_Serpent_Profile.json"
+            rows = [{"name": name, "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}]
+            for path in (base / "Stage", base / "Game.app"):
+                path.mkdir()
+                (path / name).write_bytes(data)
+            self.assertEqual(original.flat_resources(base / "Stage", rows)["verifiedFiles"], 1)
+            self.assertEqual(original.app_resources(base / "Game.app", rows,
+                             forbidden_names={active.RETIRED["name"]})["verifiedFiles"], 1)
+            for folder in (base / "Stage", base / "Game.app"):
+                (folder / active.RETIRED["name"]).write_bytes(b"old")
+            with self.assertRaises(original.CheckError) as stage:
+                original.flat_resources(base / "Stage", rows)
+            self.assertEqual(stage.exception.code, "resource-closure")
+            with self.assertRaises(original.CheckError) as app:
+                original.app_resources(base / "Game.app", rows, forbidden_names={active.RETIRED["name"]})
+            self.assertEqual(app.exception.code, "retired-app-resource")
+
+    def test_cannot_remove_legacy_if_signed_inventory_does_not_match(self):
+        with patch.object(original, "metadata", return_value=({}, {"compiledFiles": []})):
+            with self.assertRaises(original.CheckError):
+                active.active_inventory(Path("."))
