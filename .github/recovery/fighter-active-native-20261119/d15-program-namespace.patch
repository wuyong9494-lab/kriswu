+    func testD15ProgramsRequireTheAuthenticatedNamespaceAndMatchingEntryPoints() throws {
+        let token = "0123456789abcdef0123"
+        let vertex = "d15_\(token)_v", fragment = "d15_\(token)_f"
+        let file = "SF3D15FX_\(token).metal"
+        let data = Data(Self.shader.replacingOccurrences(of: "triad_fixture_v", with: vertex)
+            .replacingOccurrences(of: "triad_fixture_f", with: fragment).utf8)
+        let base = descriptor()
+        func fixture(file: String = "SF3D15FX_0123456789abcdef0123.metal",
+                     vertex: String = "d15_0123456789abcdef0123_v",
+                     fragment: String = "d15_0123456789abcdef0123_f") -> Source.Descriptor {
+            .init(sourceName: base.sourceName, shaderPathID: base.shaderPathID,
+                  sourceShaderSHA256: base.sourceShaderSHA256, variantSHA256: base.variantSHA256,
+                  projectColorSpace: base.projectColorSpace, projectAnisotropicFiltering: base.projectAnisotropicFiltering,
+                  keywords: base.keywords, floats: base.floats, colors: base.colors, textures: base.textures,
+                  program: .init(file: file, bytes: data.count, sha256: DuelNetworkContentRecord.digest(data),
+                    vertexFunction: vertex, fragmentFunction: fragment, uniforms: [], textures: [], layoutVersion: 1),
+                  raster: base.raster)
+        }
+        let d15 = fixture()
+        XCTAssertNoThrow(try d15.validate(programNamespace: .erlang))
+        XCTAssertThrowsError(try d15.validate())
+        XCTAssertThrowsError(try base.validate(programNamespace: .erlang))
+        XCTAssertThrowsError(try fixture(file: "SF3D15FX_0123456789abcdef0124.metal").validate(programNamespace: .erlang))
+        XCTAssertThrowsError(try fixture(vertex: fragment, fragment: vertex).validate(programNamespace: .erlang))
+        XCTAssertThrowsError(try fixture(fragment: "triad_fixture_f").validate(programNamespace: .erlang))
+        // The Factory revalidates after loading; exercise both gates on real Metal.
+        let gpu = try device()
+        XCTAssertNoThrow(try Source.Factory(materials: ["d15": d15], programData: [file: data],
+            textureData: [:], device: gpu, formats: [format], programNamespace: .erlang))
+        XCTAssertThrowsError(try Source.Factory(materials: ["d15": d15], programData: [file: Data("changed".utf8)],
+            textureData: [:], device: gpu, formats: [format], programNamespace: .erlang))
