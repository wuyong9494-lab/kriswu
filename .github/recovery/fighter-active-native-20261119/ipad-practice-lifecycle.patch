+#if DEBUG
+import Foundation
+
+/// Opt-in diagnostic only. Never drives readiness, simulation or presentation.
+/// One bounded ASCII token per observed phase, once per process. Rewriting the
+/// first observation truncates any previous launch's file without a test hook.
+@MainActor
+enum DuelPadPracticeTrace {
+    enum Stage: String, CaseIterable {
+        case lobbyAppeared = "lobby-appeared"
+        case practiceAction = "practice-action"
+        case presentationGuardRejected = "presentation-guard-rejected"
+        case setupAssigned = "setup-assigned"
+        case setupRejected = "setup-rejected"
+        case coverConstructed = "cover-constructed"
+        case sessionInitBegin = "session-init-begin"
+        case assetsLoadBegin = "assets-load-begin"
+        case assetsLoadEnd = "assets-load-end"
+        case catalogLoadBegin = "catalog-load-begin"
+        case catalogLoadEnd = "catalog-load-end"
+        case gameInitBegin = "game-init-begin"
+        case gameInitEnd = "game-init-end"
+        case sessionInitReady = "session-init-ready"
+        case sessionInitFailed = "session-init-failed"
+        case worldMakeBegin = "world-make-begin"
+        case worldMakeEnd = "world-make-end"
+        case worldInitBegin = "world-init-begin"
+        case stageBuildBegin = "stage-build-begin"
+        case stageBuildEnd = "stage-build-end"
+        case actorLoadBegin = "actor-load-begin"
+        case actorLoadEnd = "actor-load-end"
+        case actorBuildBegin = "actor-build-begin"
+        case actorBuildEnd = "actor-build-end"
+        case surfaceBuildBegin = "surface-build-begin"
+        case surfaceBuildEnd = "surface-build-end"
+        case morphBuildBegin = "morph-build-begin"
+        case morphBuildEnd = "morph-build-end"
+        case effectsBuildBegin = "effects-build-begin"
+        case effectsBuildEnd = "effects-build-end"
+        case initialDrawBegin = "initial-draw-begin"
+        case initialDrawEnd = "initial-draw-end"
+        case worldInitEnd = "world-init-end"
+        case controlsMakeBegin = "controls-make-begin"
+        case controlsMakeEnd = "controls-make-end"
+        case matchAppeared = "match-appeared"
+        case matchDisappeared = "match-disappeared"
+        case worldMounted = "world-mounted"
+        case worldDetached = "world-detached"
+        case clockStarted = "clock-started"
+        case firstTickBegin = "first-tick-begin"
+        case firstTickEnd = "first-tick-end"
+        case sessionShutdown = "session-shutdown"
+        case worldShutdown = "world-shutdown"
+    }
+    private static let enabled = ProcessInfo.processInfo.arguments.contains("-rift-pad-trace")
+    private static var seen = Set<Stage>()
+    private static var lines: [String] = []
+
+    static func record(_ stage: Stage, practice: Bool = true) {
+        guard enabled, practice, seen.insert(stage).inserted else { return }
+        lines.append(stage.rawValue)
+        let data = Data((lines.joined(separator: "\n") + "\n").utf8)
+        guard data.count <= 1024,
+              let directory = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask).first else { return }
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            try data.write(to: directory.appendingPathComponent("rift-pad-practice-stages.log"), options: .atomic)
+        } catch {
+            // An unavailable diagnostic sink must not alter gameplay or error UI.
+        }
+    }
+}
+#endif
