+    func testExactHeadlessMorphRejectsMissingActiveAndNewlyAttachedDormantGeometry() throws {
+        let input = try inputs(), assets = try load(input)
+        let actor = try DuelWeaponCharacterAsset(url: input.directory.appendingPathComponent(input.target.resourceName + ".glb"),
+            profile: input.target)
+        func fresh() -> GLTFModel.Instance { actor.model.instantiate() }
+        func select(_ instance: GLTFModel.Instance, _ materials: [DuelTriadSourceMorph.MaterialBinding]? = nil) throws {
+            _ = try DuelSerpentHeadlessMorphScene.select(asset: actor, instance: instance,
+                materials: materials ?? assets.materials)
+        }
+        try select(fresh())
+        let missing = fresh(); missing.nodes[80].removeFromParentNode()
+        XCTAssertThrowsError(try select(missing))
+        let attached = fresh(); attached.nodes[89].addChildNode(attached.nodes[88])
+        XCTAssertThrowsError(try select(attached))
+        let extra = fresh(); extra.root.addChildNode(SCNNode(geometry: SCNBox(width: 1, height: 1, length: 1, chamferRadius: 0)))
+        XCTAssertThrowsError(try select(extra))
+        XCTAssertThrowsError(try select(fresh(), assets.materials.filter { $0.name != "Liu_Neck_Skin" }))
+        let changed = fresh(); changed.nodes[87].childNodes[0].geometry?.materials[0].name = "unknown-dormant"
+        XCTAssertThrowsError(try select(changed))
+        let incomplete = fresh()
+        let view = GLTFModel.Instance(root: incomplete.root, nodes: incomplete.nodes,
+            materials: Array(incomplete.materials.dropLast()), outlines: incomplete.outlines)
+        XCTAssertThrowsError(try select(view))
+    }
